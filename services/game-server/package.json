{
  "name": "@jogartcg/game-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && npm run bundle:referee && npm run bundle:service",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "bundle:referee": "esbuild src/referee.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist/referee.bundle.mjs",
    "bundle:service": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist/referee-service.mjs"
  },
  "dependencies": {
    "@jogartcg/game-core": "*"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
