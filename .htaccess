Options -Indexes
RewriteEngine On

# Em producao, mantem todo o trafego no endereco canonico HTTPS.
# O X-Forwarded-Proto evita loop caso o SSL termine em um proxy da hospedagem.
RewriteCond %{HTTP_HOST} ^(?:www\.)?jogartcg\.com\.br$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://www.jogartcg.com.br%{REQUEST_URI} [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^jogartcg\.com\.br$ [NC]
RewriteRule ^ https://www.jogartcg.com.br%{REQUEST_URI} [R=301,L,NE]

RewriteRule ^config/ - [F,L]
RewriteRule ^(?:database|tests|docs)/ - [F,L]
RewriteRule ^admin/includes/ - [F,L]
RewriteRule ^admin/pages/.*\.php$ - [F,L]
RewriteRule ^admin/?$ admin/index.php [QSA,L]

# Encaminha as rotas REST para o controlador da API.
RewriteRule ^api(?:/.*)?$ api/index.php [QSA,L]

# Mantem arquivos e diretorios reais acessiveis, incluindo client e api.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^admin/ admin/index.php [QSA,L]

RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
