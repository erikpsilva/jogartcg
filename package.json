{
  "name": "jogartcg",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "gulp",
    "build": "npm run build:core && npm run build:client && npm run build:server",
    "build:core": "npm run build --workspace @jogartcg/game-core",
    "build:client": "npm run build --workspace @jogartcg/game-client",
    "build:admin": "gulp buildAdmin",
    "build:server": "npm run build --workspace @jogartcg/game-server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:game": "npm run build:core && node --test packages/game-core/cards.test.mjs packages/game-core/engine.test.mjs packages/game-core/tests/bot.test.mjs",
    "game:coverage": "node packages/game-core/cards.test.mjs --catalog",
    "test:game:catalog": "npm run build:core && node packages/game-core/tests/bot.test.mjs --catalog",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1",
    "deploy:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-production.ps1",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-production.ps1 -Publish",
    "mobile:sync": "npm run cap:sync --workspace @jogartcg/game-client",
    "mobile:android": "npm run cap:open:android --workspace @jogartcg/game-client",
    "mobile:ios": "npm run cap:open:ios --workspace @jogartcg/game-client"
  },
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "gulp": "^5.0.1",
    "gulp-clean-css": "^4.3.0",
    "gulp-less": "^5.0.0",
    "gulp-rename": "^2.1.0"
  }
}
